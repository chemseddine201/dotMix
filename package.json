{
  "name": "dotmix-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.mjs",
    "test:golden": "node --test tests/golden/golden-path.test.mjs",
    "serve": "node examples/showcase/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.0.0",
    "eslint": "9.39.5",
    "happy-dom": "15.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}

