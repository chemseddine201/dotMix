import TypeSafeCard from "./TypeSafeCard.tix";

export default function App() {
  const count = signal(1);
  const left = computed(() => count() * 2);
  const right = computed(() => count() + 10);
  const diamondSum = computed(() => left() + right());

  const showDetails = signal(true);
  const accentColor = signal("#0055cc");
  const bannerHtml = computed(() =>
    createTrustedHtml(`<em>Active Count: ${count()}</em><script>evil()<\/script>`)
  );

  const tasks = signal([
    { id: "task-1", title: "Lexer & Parser (Gate 2)" },
    { id: "task-2", title: "Semantic & Tix (Gate 3)" },
    { id: "task-3", title: "Reactive Kernel (Gate 4)" }
  ]);

  function increment() {
    count.set(count() + 1);
  }

  function toggleDetails() {
    showDetails.set(!showDetails());
  }

  function rotateTasks() {
    const current = tasks();
    if (current.length > 1) {
      tasks.set([...current.slice(1), current[0]]);
    }
  }

  return (
    <main class="showcase-shell">
      <header class="showcase-header">
        <h1>Mix/Tix Compiler-Native Showcase</h1>
        <div class="trusted-banner" mix-html={bannerHtml()}></div>
      </header>

      <section class="diamond-section" style:border-color={accentColor()}>
        <p class="diamond-readout">Count: {count()} | Left: {left()} | Right: {right()} | Sum: {diamondSum()}</p>
        <button class="inc-btn" onClick={increment}>Increment</button>
        <button class="toggle-btn" onClick={toggleDetails}>Toggle Details</button>
      </section>

      {if showDetails()}
        <section class="details-panel">
          <img
            class="responsive-hero"
            src="/assets/hero.png"
            srcset={"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA 1x, https://cdn.example.com/img?fmt=webp,avif 2x"}
            alt="Showcase Hero"
          />
          <TypeSafeCard badge="Verified .tix Child" priority={count()} />
        </section>
      {else}
        <p class="details-collapsed">Details hidden</p>
      {endif}

      <section class="tasks-section">
        <button class="rotate-btn" onClick={rotateTasks}>Rotate Tasks</button>
        <ul class="task-list">
          {each (task, idx) in tasks()}
            <li class="task-row" data-task-id={task.id}>{idx}: {task.title}</li>
          {endeach}
        </ul>
      </section>
    </main>
  );
}

<style>
  .showcase-shell {
    max-width: 720px;
    margin: 0 auto;
  }
  :global(body) .showcase-header {
    border-bottom: 2px solid #222;
  }
</style>
