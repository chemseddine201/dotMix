<script>
  let activeTab = signal("all");

  function showAll() {
    activeTab.set("all");
  }

  function showReactivity() {
    activeTab.set("reactivity");
  }

  function showTodos() {
    activeTab.set("todos");
  }

  function showCancellation() {
    activeTab.set("cancellation");
  }

  function showDynamic() {
    activeTab.set("dynamic");
  }

  function showSecurity() {
    activeTab.set("security");
  }

  function showTypeSafe() {
    activeTab.set("typesafe");
  }
</script>

<style>
  .app-container {
