  <div class="nav-bar">
    <button class="nav-btn btn-tab-all" @click={showAll}>Show All</button>
    <button class="nav-btn btn-tab-counter" @click={showCounter}>Counter</button>
    <button class="nav-btn btn-tab-dynamic" @click={showDynamic}>Dynamic Element</button>
    <button class="nav-btn btn-tab-todos" @click={showTodos}>Reconciliation</button>
    <button class="nav-btn btn-tab-security" @click={showSecurity}>Security</button>
