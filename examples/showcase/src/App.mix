<script>
  let activeTab = signal("all");

  function showAll() {
    activeTab.set("all");
  }

  function showCounter() {
    activeTab.set("counter");
  }

  function showDynamic() {
    activeTab.set("dynamic");
  }

  function showTodos() {
    activeTab.set("todos");
  }

  function showSecurity() {
    activeTab.set("security");
  }
</script>

<style>
  .app-container {
    min-height: 100vh;
    background: #11111b;
    color: #cdd6f4;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .hero-banner {
    padding: 32px;
    background: linear-gradient(135deg, #181825 0%, #1e1e2e 100%);
    border-bottom: 1px solid #313244;
    text-align: center;
  }
