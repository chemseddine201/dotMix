    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .pill {
    padding: 4px 12px;
    border-radius: 9999px;
    background: #313244;
    color: #cdd6f4;
    font-size: 0.75rem;
    font-family: monospace;
    border: 1px solid #45475a;
  }
  .nav-bar {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    background: #181825;
    border-bottom: 1px solid #313244;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav-btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #45475a;
    background: #1e1e2e;
    color: #cdd6f4;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.15s ease;
  }
  .nav-btn:hover {
    background: #313244;
    border-color: #89b4fa;
    color: #89b4fa;
  }
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 16px;
  }
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 24px;
    align-items: start;
  }
  .footer {
    text-align: center;
    padding: 32px;
    color: #6c7086;
    font-size: 0.85rem;
    border-top: 1px solid #313244;
    margin-top: 48px;
  }
</style>

<div class="app-container">
  <div class="hero-banner">
    <h2 class="hero-title">Mix / Tix Interactive Showcase</h2>
    <p class="hero-subtitle">
      Zero Virtual DOM, direct DOM compiled code, fine-grained Pull-Push reactivity, and strict security hardening.
    </p>
    <div class="feature-pills">
      <span class="pill">D-101 Pull-Push Scheduler</span>
      <span class="pill">D-105 DynamicElement</span>
