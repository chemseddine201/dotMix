<script>
  let safeHtml = signal("<strong>Safe formatted text</strong> from trusted boundary");
  let bgStyle = signal("background-color: #313244");

  function setAmber() {
    bgStyle.set("background-color: #45475a");
  }

  function setNavy() {
    bgStyle.set("background-color: #1e1e2e");
  }
</script>

<style>
  .sec-container {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    max-width: 480px;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 1px solid #313244;
    padding-bottom: 12px;
  }
  .title {
    margin: 0;
    font-size: 1.25rem;
    color: #cdd6f4;
  }
  .badge {
    background: #313244;
    color: #f9e2af;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: monospace;
  }
  .section-label {
    font-size: 0.85rem;
    color: #a6adc8;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .html-preview {
    padding: 12px 16px;
    border-radius: 8px;
    background: #11111b;
    border: 1px solid #313244;
    margin-bottom: 16px;
    color: #cdd6f4;
  }
  .style-target {
    padding: 16px;
    border-radius: 8px;
    color: #cdd6f4;
    margin-bottom: 16px;
    transition: background-color 0.2s ease;
  }
  .btn-row {
    display: flex;
    gap: 8px;
  }
  .color-btn {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #45475a;
    background: #313244;
    color: #cdd6f4;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .color-btn:hover {
    background: #45475a;
  }
</style>

<div class="sec-container">
  <div class="header">
    <h3 class="title">Security Hardening</h3>
    <span class="badge">Trusted Types (D-109)</span>
  </div>

  <div class="section-label">Trusted HTML (Sanitizer Boundary):</div>
  <div class="html-preview" mix-html={safeHtml()}></div>

  <div class="section-label">Safe Dynamic Style (D-108):</div>
  <div class="style-target" style={bgStyle()}>
    Dynamic style evaluated with strict CSS escape decoding and injection prevention.
  </div>

  <div class="btn-row">
    <button class="color-btn" @click={setNavy}>Navy Background</button>
    <button class="color-btn" @click={setAmber}>Slate Background</button>
  </div>
</div>

