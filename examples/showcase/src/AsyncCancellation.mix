<script>
  let query = signal("TypeScript");
  let status = signal("Idle");
  let activeGeneration = signal(0);

  function startQuery() {
    const gen = activeGeneration() + 1;
    activeGeneration.set(gen);
    status.set("Fetching results for: " + query() + " (Gen #" + gen + ")...");
  }

  function cancelQuery() {
    status.set("Cancelled via CancellationToken (MIX_RT_ABORTED)");
  }
</script>

<style>
  .cancellation-card {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #313244;
  }
  .card-title {
    font-size: 1.25rem;
    color: #cdd6f4;
    font-weight: 700;
  }
  .badge-token {
    background: #313244;
    color: #fab387;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: monospace;
    border: 1px solid #fab387;
  }
  .status-box {
    padding: 12px 16px;
    border-radius: 8px;
    background: #11111b;
    border: 1px solid #45475a;
    font-family: monospace;
    font-size: 0.9rem;
    color: #fab387;
    margin: 16px 0;
  }
  .action-row {
    display: flex;
    gap: 8px;
  }
  .btn-start {
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #89b4fa;
    background: #89b4fa;
    color: #11111b;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-cancel {
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #f38ba8;
    background: transparent;
    color: #f38ba8;
    cursor: pointer;
  }
  .btn-cancel:hover {
    background: #f38ba8;
    color: #11111b;
  }
</style>

<div class="cancellation-card">
  <div class="card-header">
    <h3 class="card-title">Pure ECMAScript Cancellation Token (§3)</h3>
    <span class="badge-token">CancellationTokenSource</span>
  </div>

  <div class="status-box">
    <div>Operation Status: <strong>{status()}</strong></div>
  </div>

  <div class="action-row">
    <button class="btn-start" @click={startQuery}>Start Async Query</button>
    <button class="btn-cancel" @click={cancelQuery}>Abort Current Token</button>
  </div>
</div>
