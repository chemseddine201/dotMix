import { syncCollection, getDefaultSyncEngine, BroadcastChannelTransport } from "@mix/sync";

export default function TasksPage() {
  const engine = getDefaultSyncEngine();
  if (typeof window !== "undefined" && !window.__MIX_TEST_ENV__ && !window.__mix_tasks_channel_set) {
    window.__mix_tasks_channel_set = true;
    engine.setChannel(new BroadcastChannelTransport("mix_showcase_tasks"));
  }

  const taskStore = syncCollection("showcase-tasks", {
    driver: "indexeddb",
    initialItems: [
      { id: "t-1", title: "Compile AST directly to surgical DOM", done: true, priority: 1 },
      { id: "t-2", title: "Verify O(N log N) LIS minimal DOM movement", done: true, priority: 2 },
      { id: "t-3", title: "Ship React Router v6/v7 Parity Engine", done: true, priority: 1 },
      { id: "t-4", title: "Ship Local-First Offline CRDT Sync Engine (@mix/sync)", done: false, priority: 1 }
    ]
  });

  const tasks = taskStore.items;
  const draftTitle = signal("");
  const filter = signal("all");

  const total = computed(() => tasks().length);
  const completed = computed(() => tasks().filter((t) => t.done).length);
  const pending = computed(() => total() - completed());

  const visibleTasks = computed(() => {
    const f = filter();
    const list = tasks();
    if (f === "active") return list.filter((t) => !t.done);
    if (f === "done") return list.filter((t) => t.done);
    return list;
  });

  function handleInput(e) {
    draftTitle.set(e.target.value);
  }

  function addTask() {
    const title = draftTitle().trim() || `Sprint Task #${total() + 1}`;
    taskStore.insert({ id: `t-${Date.now()}`, title, done: false, priority: 1 });
    draftTitle.set("");
    filter.set("all");
  }

  function toggleTask(id) {
    const t = tasks().find((item) => item.id === id);
    if (t) {
      taskStore.update(id, { done: !t.done });
    }
  }

  function deleteTask(id, e) {
    if (e && typeof e.stopPropagation === "function") {
      e.stopPropagation();
    }
    taskStore.delete(id);
  }

  function rotateList() {
    const list = tasks();
    if (list.length > 1) {
      taskStore.reorder(0, list.length - 1);
    }
  }

  function toggleNetwork() {
    if (engine.isOnline()) {
      engine.goOffline();
    } else {
      engine.goOnline();
    }
  }

  return (
    <div class="page-tasks">
      <div class="tasks-header">
        <div class="header-titles">
          <h2>📋 Local-First Task Board (@mix/sync CRDT)</h2>
          <p>Instant 0ms mutations, IndexedDB persistence, cross-tab BroadcastChannel, and LIS minimal DOM movements.</p>
        </div>
        <div class="sync-banner">
          <div class="sync-status">
            <span class={"status-indicator " + engine.status()}></span>
            <span class="status-label">
              Network: <strong>{engine.isOnline() ? "Online" : "Simulated Offline"}</strong>
              {" · Store: "}
              <span class={"sync-badge " + taskStore.status()}>{taskStore.status().toUpperCase()}</span>
              {taskStore.pendingCount() > 0 ? ` (${taskStore.pendingCount()} buffered in DB)` : ""}
            </span>
          </div>
          <button class={"btn-network " + (engine.isOnline() ? "btn-disconnect" : "btn-connect")} onClick={toggleNetwork}>
            {engine.isOnline() ? "🔌 Disconnect (Simulate Offline)" : "⚡ Reconnect & Flush Queue"}
          </button>
        </div>
      </div>

      <div class="composer-bar">
        <input
          class="task-input"
          type="text"
          value={draftTitle()}
          placeholder="New sprint task title..."
          onInput={handleInput}
        />
        <button class="btn-primary" onClick={addTask}>+ Add Task</button>
        <button class="btn-secondary" onClick={rotateList}>Rotate Order (LIS)</button>
      </div>

      <div class="filter-bar">
        <button class={"tab-btn " + (filter() === "all" ? "active" : "")} onClick={() => filter.set("all")}>All ({total()})</button>
        <button class={"tab-btn " + (filter() === "active" ? "active" : "")} onClick={() => filter.set("active")}>Active ({pending()})</button>
        <button class={"tab-btn " + (filter() === "done" ? "active" : "")} onClick={() => filter.set("done")}>Done ({completed()})</button>
      </div>

      <ul class="task-list">
        {each (task, idx) in visibleTasks()}
          <li class={"task-item " + (task.done ? "is-done" : "")} data-id={task.id} onClick={() => toggleTask(task.id)}>
            <span class="task-num">#{idx + 1}</span>
            <span class="task-text">{task.title}</span>
            <span class="task-status">{task.done ? "✓ Done" : "○ Pending"}</span>
            <button class="btn-delete" onClick={(e) => deleteTask(task.id, e)} title="Delete task">×</button>
          </li>
        {endeach}
      </ul>
    </div>
  );
}

<style>
  .page-tasks {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #ffffff;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .tasks-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e2e8f0;
  }
  .header-titles h2 {
    margin: 0 0 6px 0;
    font-size: 18px;
    color: #0f172a;
  }
  .header-titles p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
  }
  .sync-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }
  .sync-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #334155;
  }
  .status-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .status-indicator.synced {
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .status-indicator.syncing {
    background: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }
  .status-indicator.offline {
    background: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
  }
  .sync-badge {
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
  }
  .sync-badge.synced {
    background: #d1fae5;
    color: #065f46;
  }
  .sync-badge.syncing {
    background: #fef3c7;
    color: #92400e;
  }
  .sync-badge.offline {
    background: #fee2e2;
    color: #991b1b;
  }
  .btn-network {
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid;
    transition: all 0.15s ease;
  }
  .btn-disconnect {
    background: #fff1f2;
    color: #be123c;
    border-color: #fecdd3;
  }
  .btn-disconnect:hover {
    background: #ffe4e6;
  }
  .btn-connect {
    background: #ecfdf5;
    color: #047857;
    border-color: #a7f3d0;
  }
  .btn-connect:hover {
    background: #d1fae5;
  }
  .composer-bar {
    display: flex;
    gap: 10px;
  }
  .task-input {
    flex: 1;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    font-size: 14px;
  }
  .btn-primary {
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    background: #2563eb;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-secondary {
    padding: 8px 14px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-bar {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 10px;
  }
  .tab-btn {
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .tab-btn.active {
    background: #eff6ff;
    color: #2563eb;
    border-color: #bfdbfe;
  }
  .task-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }
  .task-item {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    gap: 12px;
    cursor: pointer;
  }
  .task-item:last-child {
    border-bottom: none;
  }
  .task-item:hover {
    background: #f8fafc;
  }
  .task-num {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    width: 24px;
  }
  .task-text {
    flex: 1;
    font-size: 14px;
    color: #1e293b;
  }
  .task-item.is-done .task-text {
    text-decoration: line-through;
    color: #94a3b8;
  }
  .task-status {
    font-size: 12px;
    font-weight: 600;
    color: #059669;
  }
  .task-item:not(.is-done) .task-status {
    color: #d97706;
  }
  .btn-delete {
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #94a3b8;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-delete:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }
</style>
