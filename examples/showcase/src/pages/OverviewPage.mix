import MetricCard from "../components/MetricCard.tix";
import { useOutletContext } from "@mix/router";

export default function OverviewPage() {
  const count = signal(1);
  const left = computed(() => count() * 2);
  const right = computed(() => count() + 10);
  const sum = computed(() => left() + right());

  const ctx = useOutletContext();

  const securityBanner = computed(() =>
    createTrustedHtml(
      `<strong>Framework Security Verified:</strong> Trusted HTML active, XSS injection blocked.<script>alert("blocked")<\/script>`
    )
  );

  function increment() {
    count.set(count() + 1);
  }

  function decrement() {
    if (count() > 1) {
      count.set(count() - 1);
    }
  }

  return (
    <div class="page-overview">
      <div class="overview-hero">
        <h2 class="hero-title">⚡ Mix / Tix Compiler-Native Architecture</h2>
        <p class="hero-subtitle">
          Ahead-of-Time surgical DOM compilation with zero Virtual DOM overhead.
        </p>
        <div class="security-banner" mix-html={securityBanner()}></div>
      </div>

      <div class="metrics-row">
        <MetricCard label="Active Nodes" value={count()} unit="" trend="up" />
        <MetricCard label="Throughput" value={sum()} unit="k ops/s" trend="up" />
        <MetricCard label="Reactivity Latency" value={1} unit="ms" trend="up" />
      </div>

      <div class="diamond-box">
        <h3>Push-Pull Diamond Reactivity (Gate 4)</h3>
        <p class="diamond-formula">
          Count: <strong>{count()}</strong> | Left (×2): <strong>{left()}</strong> | Right (+10): <strong>{right()}</strong> ⇒ Sum: <strong>{sum()}</strong>
        </p>
        <div class="diamond-buttons">
          <button class="btn-action btn-inc" onClick={increment}>+ Increment Count</button>
          <button class="btn-action btn-dec" onClick={decrement}>- Decrement Count</button>
        </div>
      </div>
    </div>
  );
}

<style>
  .page-overview {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .overview-hero {
    padding: 20px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .hero-title {
    margin: 0 0 8px 0;
    font-size: 20px;
    color: #0f172a;
  }
  .hero-subtitle {
    margin: 0 0 12px 0;
    color: #64748b;
    font-size: 14px;
  }
  .security-banner {
    padding: 8px 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    font-size: 13px;
    color: #1e40af;
  }
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .diamond-box {
    padding: 20px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .diamond-box h3 {
    margin: 0 0 8px 0;
    font-size: 16px;
    color: #0f172a;
  }
  .diamond-formula {
    font-size: 15px;
    color: #475569;
    margin-bottom: 14px;
  }
  .diamond-formula strong {
    color: #2563eb;
  }
  .diamond-buttons {
    display: flex;
    gap: 10px;
  }
  .btn-action {
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-action:hover {
    background: #e2e8f0;
  }
</style>

