import { createBrowserRouter, createMemoryRouter, RouterProvider } from "@mix/router";
import { setSanitizerProvider } from "@mix/runtime";
import { createDomPurifySanitizer } from "@mix/sanitizer-dompurify";
import DashboardLayout from "./DashboardLayout.mix";
import OverviewPage from "./pages/OverviewPage.mix";
import TasksPage from "./pages/TasksPage.mix";
import FormsPage from "./pages/FormsPage.mix";
import SyncPage from "./pages/SyncPage.mix";
import UserPage from "./pages/UserPage.mix";
import ReportsPage from "./pages/ReportsPage.mix";
import AnalyticsPage from "./pages/AnalyticsPage.mix";
import AsyncPage from "./pages/AsyncPage.mix";
import PermissionsPage from "./pages/PermissionsPage.mix";
import "./MasterApp.css";

// Configure application security sanitizer authority (D-109 / HAA-03)
setSanitizerProvider(createDomPurifySanitizer());

export default function MasterApp() {
  const routes = [
    {
      path: "/",
      element: OverviewPage,
    },
    {
      path: "/tasks",
      element: TasksPage,
    },
    {
      path: "/forms",
      element: FormsPage,
    },
    {
      path: "/sync",
      element: SyncPage,
    },
    {
      path: "/users/:id",
      element: UserPage,
    },
    {
      path: "/reports/*",
      element: ReportsPage,
    },
    {
      path: "/analytics",
      element: AnalyticsPage,
    },
    {
      path: "/async",
      element: AsyncPage,
    },
    {
      path: "/permissions",
      element: PermissionsPage,
    }
  ];

  const router = typeof window !== "undefined" && window.history && typeof window.history.pushState === "function" && !window.__MIX_TEST_ENV__
    ? createBrowserRouter(routes)
    : createMemoryRouter(routes);

  return (
    <RouterProvider router={router}>
      <div class="master-root">
        <DashboardLayout />
      </div>
    </RouterProvider>
  );
}

<style src="./MasterApp.css"></style>
