import MetricCard from "./MetricCard.tix";

export default function StatefulWorkspace() {
  // 1. Fine-grained reactive state signals (Push-Pull kernel)
  const tasks = signal([
    { id: "t-101", title: "Compile .mix & .tix AST", done: true, priority: 1 },
    { id: "t-102", title: "Verify TypeScript 6.0.3 Projection", done: true, priority: 2 },
    { id: "t-103", title: "Ship Keyed LIS DOM Reconciler", done: false, priority: 1 }
  ]);

  const filter = signal("all");
  const draftTitle = signal("Add SSR Hydration Boundary");
  const draftPriority = signal(2);
  const nextIdSeq = signal(104);
  const headingTag = "h2";
  const accentColor = signal("#0b5fff");

  // 2. Derived computed signals (glitch-free topological evaluation)
  const totalCount = computed(() => tasks().length);
  const completedCount = computed(() => tasks().filter((t) => t.done).length);
  const pendingCount = computed(() => totalCount() - completedCount());
  const completionRate = computed(() =>
    totalCount() === 0 ? 0 : Math.round((completedCount() / totalCount()) * 100)
  );
  const healthTrend = computed(() =>
    completionRate() >= 75 ? "up" : completionRate() < 40 ? "down" : "neutral"
  );

  const visibleTasks = computed(() => {
    const mode = filter();
    const list = tasks();
    if (mode === "active") return list.filter((t) => !t.done);
    if (mode === "done") return list.filter((t) => t.done);
    return list;
  });

  // 3. Trusted HTML security boundary (D-109 / HAA-03)
  const statusBannerHtml = computed(() =>
    createTrustedHtml(
      `<strong>Release Readiness: ${completionRate()}%</strong> (${completedCount()}/${totalCount()} done)<script>alert("blocked")<\/script>`
    )
  );

  // 4. Reactive effect with deterministic owner cleanup (D-101, D-102)
  let effectLogCount = 0;
  let cleanupLogCount = 0;
  createEffect(() => {
    const _snapshot = `${filter()}:${completedCount()}/${totalCount()}`;
    void _snapshot;
    effectLogCount++;
    onCleanup(() => {
      cleanupLogCount++;
    });
  });

  // 5. Stateful actions & batched multi-signal transactions
  function setFilterAll() {
    filter.set("all");
  }

  function setFilterActive() {
    filter.set("active");
  }

  function setFilterDone() {
    filter.set("done");
  }

  function addTask() {
    const title = draftTitle().trim();
    if (!title) return;
    const id = `t-${nextIdSeq()}`;
    const priority = draftPriority();

    // Batch multiple signal writes into a single glitch-free DOM commit
    batch(() => {
      tasks.set([...tasks(), { id, title, done: false, priority }]);
      nextIdSeq.set(nextIdSeq() + 1);
      draftTitle.set("");
      filter.set("all");
    });
  }

  function toggleFirstPending() {
    tasks.set(
      tasks().map((t) => (t.done ? t : { ...t, done: true }))
    );
  }

  function clearCompleted() {
    batch(() => {
      tasks.set(tasks().filter((t) => !t.done));
      filter.set("all");
    });
  }

  function rotateVisibleOrder() {
    const current = tasks();
    if (current.length > 1) {
      tasks.set([...current.slice(1), current[0]]);
    }
  }

  return (
    <main class="workspace-app" style:border-color={accentColor()}>
      <header class="workspace-header">
        <$headingTag class="workspace-heading">Mix/Tix Stateful Release Workspace</$headingTag>
        <div class="workspace-banner" mix-html={statusBannerHtml()}></div>
        <img
          class="workspace-avatar"
          src="/assets/release-badge.png"
          srcset={"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA 1x, https://cdn.example.com/badge?fmt=webp,avif 2x"}
          alt="Release Badge"
        />
      </header>

      <section class="metrics-grid">
        <MetricCard label="Total Tasks" value={totalCount()} unit="" trend="neutral" />
        <MetricCard label="Completed" value={completedCount()} unit="" trend={healthTrend()} />
        <MetricCard label="Completion" value={completionRate()} unit="%" trend={healthTrend()} />
      </section>

      <section class="composer-bar">
        <span class="draft-preview">Draft: {draftTitle()} (P{draftPriority()})</span>
        <button class="btn-add-task" onClick={addTask}>Add Task</button>
        <button class="btn-complete-all" onClick={toggleFirstPending}>Complete All</button>
        <button class="btn-clear-done" onClick={clearCompleted}>Clear Completed</button>
        <button class="btn-rotate-tasks" onClick={rotateVisibleOrder}>Rotate Order</button>
      </section>

      <nav class="filter-tabs" data-active-filter={filter()}>
        <button class="filter-all" onClick={setFilterAll}>All ({totalCount()})</button>
        <button class="filter-active" onClick={setFilterActive}>Active ({pendingCount()})</button>
        <button class="filter-done" onClick={setFilterDone}>Done ({completedCount()})</button>
      </nav>

      {if totalCount() === 0}
        <p class="workspace-status status-empty">No tasks in workspace.</p>
      {elseif pendingCount() === 0}
        <p class="workspace-status status-complete">All {totalCount()} tasks completed! Ready to ship.</p>
      {else}
        <p class="workspace-status status-active">{pendingCount()} task(s) remaining in current sprint.</p>
      {endif}

      <ul class="workspace-task-list">
        {each (task, idx) in visibleTasks()}
          <li class="workspace-task-item" data-id={task.id} data-done={task.done}>
            <span class="task-index">#{idx + 1}</span>
            <strong class="task-title">{task.title}</strong>
            <span class="task-priority">P{task.priority}</span>
          </li>
        {endeach}
      </ul>
    </main>
  );
}

<style>
  .workspace-app {
    max-width: 840px;
    margin: 0 auto;
    padding: 16px;
    border-width: 2px;
    border-style: solid;
  }
  :global(body) .workspace-header {
    margin-bottom: 16px;
  }
</style>
