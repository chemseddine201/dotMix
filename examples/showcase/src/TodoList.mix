<script>
  let tasks = signal([
    { id: 1, text: "Explore Mix / Tix AOT compiler", done: true },
    { id: 2, text: "Verify 5-state Push-Pull reactive scheduler", done: false },
    { id: 3, text: "Test O(N log N) LIS keyed reconciliation", done: false },
    { id: 4, text: "Validate WHATWG security and sanitizers", done: false }
  ]);
  let nextId = signal(5);

  function addTask() {
    const id = nextId();
    nextId.set((n) => n + 1);
    tasks.set((list) => [
      ...list,
      { id, text: "New task #" + id, done: false }
    ]);
  }

  function removeFirst() {
    tasks.set((list) => list.slice(1));
  }

  function reverseTasks() {
    tasks.set((list) => [...list].reverse());
  }

  function shuffleTasks() {
    tasks.set((list) => {
      const copy = [...list];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = copy[i];
        copy[i] = copy[j];
        copy[j] = temp;
      }
      return copy;
    });
  }

  function toggleFirst() {
    tasks.set((list) => {
      if (list.length === 0) return list;
      return [
        { ...list[0], done: !list[0].done },
        ...list.slice(1)
      ];
    });
  }
</script>

<style>
  .todo-card {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #313244;
  }
  .card-title {
    font-size: 1.25rem;
    color: #cdd6f4;
    font-weight: 700;
  }
  .badge-algo {
    background: #313244;
    color: #a6e3a1;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: monospace;
    border: 1px solid #a6e3a1;
  }
  .action-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .btn-action {
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid #45475a;
    background: #313244;
    color: #cdd6f4;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-action:hover {
    background: #45475a;
    border-color: #89b4fa;
  }
  .btn-primary {
    background: #89b4fa;
    color: #11111b;
    border-color: #89b4fa;
    font-weight: 600;
  }
  .btn-primary:hover {
    background: #b4befe;
  }
  .task-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .task-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 8px;
    color: #cdd6f4;
    font-size: 0.9rem;
  }
  .task-done {
    text-decoration: line-through;
    opacity: 0.6;
  }
</style>

<div class="todo-card">
  <div class="card-header">
    <h3 class="card-title">Keyed List Reconciliation (LIS O(N log N))</h3>
    <span class="badge-algo">6-Step Diff</span>
  </div>

  <div class="action-toolbar">
    <button class="btn-action btn-primary" @click={addTask}>+ Add Task</button>
    <button class="btn-action" @click={removeFirst}>Remove Top</button>
    <button class="btn-action" @click={reverseTasks}>Reverse Order</button>
    <button class="btn-action" @click={shuffleTasks}>Shuffle LIS</button>
    <button class="btn-action" @click={toggleFirst}>Toggle Top</button>
  </div>

  <div class="task-list">
    {#each tasks() as task (task.id)}
      <div class="task-item">
        <span>{task.text}</span>
        <span class="badge-algo">{task.done ? "Completed" : "Active"}</span>
      </div>
    {/each}
  </div>
</div>
