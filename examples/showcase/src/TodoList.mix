<script>
  let newTodoText = signal("Explore Mix / Tix compiler");
  let todoCount = signal(3);
  let completedCount = signal(1);

  function markCompleted() {
    completedCount.set((c) => c + 1);
  }

  function resetAll() {
    completedCount.set(0);
    todoCount.set(0);
  }
</script>

<style>
  .todo-container {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    max-width: 480px;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 1px solid #313244;
    padding-bottom: 12px;
  }
  .title {
    margin: 0;
    font-size: 1.25rem;
    color: #cdd6f4;
  }
  .badge {
    background: #313244;
    color: #a6e3a1;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: monospace;
  }
  .stats-bar {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    padding: 10px 14px;
    background: #11111b;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #a6adc8;
  }
  .stat-val {
    font-weight: 700;
    color: #89b4fa;
  }
  .todo-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .todo-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 8px;
    color: #cdd6f4;
    font-size: 0.9rem;
  }
  .todo-item-done {
    text-decoration: line-through;
    opacity: 0.6;
  }
  .check-btn {
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #a6e3a1;
    background: transparent;
    color: #a6e3a1;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .check-btn:hover {
    background: #a6e3a1;
    color: #11111b;
  }
  .reset-row {
    display: flex;
    justify-content: flex-end;
  }
  .btn-clear {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #45475a;
    background: #313244;
    color: #cdd6f4;
    cursor: pointer;
    font-size: 0.8rem;
  }
  .btn-clear:hover {
    background: #45475a;
  }
</style>

<div class="todo-container">
  <div class="header">
    <h3 class="title">Reconciliation and State (D-110)</h3>
    <span class="badge">Fine-Grained DOM</span>
  </div>

  <div class="stats-bar">
    <div>Total Tasks: <span class="stat-val">{todoCount()}</span></div>
    <div>Completed: <span class="stat-val">{completedCount()}</span></div>
  </div>

  <div class="todo-list">
    <div class="todo-item todo-item-done">
      <span>Zero Virtual DOM architecture</span>
      <span class="badge">Done</span>
    </div>
    <div class="todo-item">
      <span>Deterministic direct DOM code generation</span>
      <button class="check-btn" @click={markCompleted}>Complete</button>
    </div>
    <div class="todo-item">
      <span>Verify live state preservation during HMR</span>
      <button class="check-btn" @click={markCompleted}>Complete</button>
    </div>
  </div>

  <div class="reset-row">
    <button class="btn-clear" @click={resetAll}>Reset Counts</button>
  </div>
</div>
