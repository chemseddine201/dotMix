import Header from "./components/Header.mix";
import Sidebar from "./components/Sidebar.mix";
import Breadcrumbs from "./components/Breadcrumbs.mix";
import { Outlet } from "@mix/router";
import "./DashboardLayout.css";

export default function DashboardLayout() {
  const theme = signal("light");

  function toggleTheme() {
    theme.set(theme() === "light" ? "dark" : "light");
  }

  return (
    <div class={"dashboard-shell theme-" + theme()}>
      <Header title="⚡ Mix / Tix All-In-One Enterprise Architecture" theme={theme()} onToggleTheme={toggleTheme} />
      <div class="dashboard-body">
        <Sidebar />
        <main class="dashboard-main">
          <Breadcrumbs mounts={1} />
          <div class="outlet-viewport">
            <Outlet context={{ tier: "Production", release: "Phase 15 Certified" }} />
          </div>
        </main>
      </div>
    </div>
  );
}

<style src="./DashboardLayout.css"></style>
