import Badge from "../../ui/Badge.tix";
import ActionButton from "../../ui/ActionButton.tix";
import { signal } from "@dotmix/runtime";
import { Await } from "@dotmix/runtime/directives";

export default function AwaitComponentDemo() {
  function loadProfile(userId: number): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      setTimeout(() => {
        if (userId < 0) {
          reject(new Error("User " + userId + " does not exist"));
        } else {
          resolve("User " + userId);
        }
      }, 500);
    });
  }

  const request = signal<Promise<string>>(loadProfile(1));

  return (
    <div>
      <ActionButton label="Load user 7" onPress={() => { request.set(loadProfile(7)); }} />
      <ActionButton label="Load a missing user" onPress={() => { request.set(loadProfile(-1)); }} />


      <Await
        promise={request()}
        pending={<p>Loading profile...</p>}
        catch={(failure) => <Badge tone="danger">{String(failure())}</Badge>}
      >
        {(profile) => <Badge tone="success">{profile()}</Badge>}
      </Await>
    </div>
  );
}
