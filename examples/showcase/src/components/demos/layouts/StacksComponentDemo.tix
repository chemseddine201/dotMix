import ActionButton from "../../ui/ActionButton.tix";
import { signal } from "@dotmix/runtime";
import { Push, Prepend, Stack } from "@dotmix/runtime/directives";

export default function StacksComponentDemo() {
  const showWarning = signal<boolean>(false);
  const showTip = signal<boolean>(false);

  return (
    <div>
      <ActionButton label="Toggle warning (push)" onPress={() => showWarning.set(!showWarning())} />
      <ActionButton label="Toggle tip (prepend)" onPress={() => showTip.set(!showTip())} />


      <Stack name="component-notices" />
      {if showWarning()}
        <Push to="component-notices" once="warning">
          <p>Warning</p>
        </Push>
      {endif}
      {if showTip()}
        <Prepend to="component-notices">
          <p>Tip (always first)</p>
        </Prepend>
      {endif}
    </div>
  );
}
