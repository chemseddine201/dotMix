import Badge from "../../ui/Badge.tix";
import ActionButton from "../../ui/ActionButton.tix";
import { signal } from "@dotmix/runtime";

export default function IfBlockDemo() {
  const stock = signal<number>(12);

  return (
    <div>
      <ActionButton label="Remove 5" onPress={() => stock.set(stock() - 5)} />
      <ActionButton label="Add 5" onPress={() => stock.set(stock() + 5)} />
      <ActionButton label="Sell out" onPress={() => stock.set(0)} />
      <p>Items in stock: {stock()}</p>


      {if stock() > 10}
        <Badge tone="success">In stock</Badge>
      {elseif stock() > 0}
        <Badge tone="warning">Low stock</Badge>
      {else}
        <Badge tone="danger">Sold out</Badge>
      {endif}
    </div>
  );
}
