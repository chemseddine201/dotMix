import ActionButton from "../../ui/ActionButton.tix";
import { signal } from "@dotmix/runtime";

export default function IsEmptyBlockDemo() {
  const messages = signal<string[]>([]);

  return (
    <div>
      <ActionButton label="Add message" onPress={() => messages.set([...messages(), "Message " + (messages().length + 1)])} />
      <ActionButton label="Clear" onPress={() => messages.set([])} />


      {isempty messages()}
        <p>No messages yet</p>
      {else}
        <p>{messages().length} message(s)</p>
      {endisempty}
    </div>
  );
}
