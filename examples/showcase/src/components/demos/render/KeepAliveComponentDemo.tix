import ActionButton from "../../ui/ActionButton.tix";
import { signal } from "@dotmix/runtime";
import { KeepAlive } from "@dotmix/runtime/directives";

export default function KeepAliveComponentDemo() {
  const activeTab = signal<string>("notes");

  return (
    <div>
      <ActionButton label="notes" onPress={() => activeTab.set("notes")} active={activeTab() === "notes"} />
      <ActionButton label="tasks" onPress={() => activeTab.set("tasks")} active={activeTab() === "tasks"} />
      <ActionButton label="files" onPress={() => activeTab.set("files")} active={activeTab() === "files"} />
      <p>Active tab: {activeTab()}</p>


      <KeepAlive activeKey={activeTab()} max={5}>
        {() => <label>Draft: <input type="text" /></label>}
      </KeepAlive>
    </div>
  );
}
