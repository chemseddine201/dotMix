interface MetricCardProps {
  label: string;
  value: number;
  unit?: string;
  trend?: string;
  tag?: string;
}

export default function MetricCard(
  props: MetricCardProps = {
    label: "Metric",
    value: 0,
    unit: "",
    trend: "neutral",
    tag: "article"
  }
) {
  const cardRef = createRef<Element | null>(null);
  const tagName = props.tag ?? "article";

  return (
    <$tagName class="metric-card" ref={cardRef} data-trend={props.trend}>
      <span class="metric-label">{props.label}</span>
      <strong class="metric-value">{props.value}{props.unit}</strong>
      {if props.trend === "up"}
        <em class="trend-badge trend-up">▲ Healthy</em>
      {elseif props.trend === "down"}
        <em class="trend-badge trend-down">▼ Needs Attention</em>
      {else}
        <em class="trend-badge trend-flat">● Stable</em>
      {endif}
    </$tagName>
  );
}

<style>
  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 12px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
  }
  .metric-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    font-weight: 700;
  }
  .metric-value {
    font-size: 24px;
    color: #0f172a;
    font-weight: 800;
  }
  .trend-badge {
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
  }
  .trend-up {
    color: #059669;
  }
  .trend-down {
    color: #dc2626;
  }
  .trend-flat {
    color: #64748b;
  }
</style>

