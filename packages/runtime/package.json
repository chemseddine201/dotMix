{
  "name": "@dotmix/runtime",
  "version": "0.1.1",
  "description": "Zero-dependency reactive runtime for compiled dotMix components",
  "files": [
    "dist",
    "client.d.ts"
  ],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemseddine201/dotMix.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./typecheck": {
      "types": "./dist/typecheck/index.d.ts",
      "default": "./dist/typecheck/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "default": "./dist/permissions/index.js"
    },
    "./directives": {
      "types": "./dist/directives/index.d.ts",
      "default": "./dist/directives/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@dotmix/diagnostics": "0.1.1"
  },
  "license": "MIT"
}
