{
  "name": "mix-helpers",
  "version": "0.1.0",
  "description": "Zero-dependency native standard library for dotMix (data, datetime, http, async, web)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "default": "./dist/datetime/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "default": "./dist/async/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "dependencies": {
    "@mix/runtime": "0.1.0"
  },
  "license": "MIT"
}
