import "./TasksPage.{{styleExt}}";
import { taskStore } from "../stores/taskSyncStore.js";
import TaskItem from "../components/domain/TaskItem.mix";
import SyncStatusPill from "../components/domain/SyncStatusPill.mix";
import Button from "../components/common/Button.mix";

export default function TasksPage() {
  const items = taskStore.items;
  const newTitle = signal("");

  function addTask() {
    const val = newTitle().trim();
    if (!val) return;
    taskStore.insert({
      id: `task-${Date.now()}`,
      title: val,
      completed: false,
      ownerId: 1
    });
    newTitle.set("");
  }

  function toggleTask(id) {
    const found = items().find((t) => t.id === id);
    if (found) {
      taskStore.update(id, { completed: !found.completed });
    }
  }

  function deleteTask(id) {
    taskStore.delete(id);
  }

  return (
    <div class="tasks-page">
      <div class="tasks-header">
        <h2>Offline-First CRDT Tasks</h2>
        <SyncStatusPill pendingCount={taskStore.pendingCount()} />
      </div>
      <div class="task-input-bar">
        <input
          class="task-input"
          value={newTitle()}
          placeholder="What needs to be done?"
          @input={(e) => newTitle.set(e.target.value)}
        />
        <Button variant="primary" onClick={addTask}>Add Task</Button>
      </div>
      <ul class="task-list">
        {each (task, idx) in items()}
          <TaskItem task={task} onToggle={toggleTask} onDelete={deleteTask} />
        {endeach}
      </ul>
    </div>
  );
}
